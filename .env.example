# Gemini is still required for the existing gemini-embedding-001 FAISS index.
# Add your own Gemini API key locally.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_LLM_MODEL=gemini-3.6-flash

# Local Ollama generation layer
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

RAG_MIN_SIMILARITY=0.55
RAG_TOP_K=5
